{
  "name": "ai-automation-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI automation platform and agents builder",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace client & wait",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces",
    "test:e2e": "npm run test:e2e --workspace client",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "promo": "npm run promo --workspace server --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    }
  }
}

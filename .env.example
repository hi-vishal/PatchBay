# Copy to .env at the repo root. Both the server and Vite read this one file,
# and docker compose uses it for variable substitution.
# Never commit .env. See README.md for where each value comes from.

# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Local dev. docker compose overrides this with the mongo service address.
MONGODB_URI=mongodb://localhost:27017/ai_automation
# Set to true only when the API runs behind a trusted reverse proxy.
TRUST_PROXY=false
# API processes to run on this machine. Set it to the number of CPU cores.
WEB_CONCURRENCY=1
# Database connections each API process may open.
MONGODB_MAX_POOL_SIZE=20
# Requests one address may make each minute, across all routes.
RATE_LIMIT_PER_MINUTE=300

# 32 bytes, base64 encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Firebase Admin (server). From a Firebase service account JSON. ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the literal \n sequences.
FIREBASE_PRIVATE_KEY=""

# --- LLM providers. Set at least one, or let each person add their own in Settings. ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# This key is shared by every user, so it only runs OpenRouter's free models.
OPENROUTER_API_KEY=
# Used when a request does not name a model. Format: provider:model
DEFAULT_MODEL=anthropic:claude-opus-5-5

# --- Ollama (local models). No key needed. Every user can use the Ollama set here. ---
# Used by npm run dev. Leave empty to turn it off.
OLLAMA_BASE_URL=http://localhost:11434
# Used by docker compose instead, because localhost inside a container is the container.
# To turn it on, set it to: http://host.docker.internal:11434
OLLAMA_DOCKER_URL=

# --- MCP ---
# stdio servers run a local command on the API host. Leave false unless every
# user of this deployment is trusted.
MCP_ALLOW_STDIO=false
# Lets http MCP servers use private or local addresses. For local development only.
MCP_ALLOW_PRIVATE_NETWORKS=false

# --- Razorpay (test mode only: the API refuses to start unless the key id begins rzp_test_) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan id from the Razorpay dashboard, Subscriptions > Plans.
RAZORPAY_PRO_PLAN_ID=
# What the pricing section shows. Keep it the same as the plan's amount in Razorpay.
PRO_PLAN_PRICE_LABEL=₹999 per month

# --- Client (exposed to the browser, so public values only) ---
# Leave empty to call the API on the same origin (Vite proxy or nginx).
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
